{
  "name": "rita-assistant",
  "version": "0.1.0",
  "description": "Rita - fully local desktop assistant (AYO-style, clean-room rebuild)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "helper": "python -m rita_listener",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.skill3r01.rita",
    "productName": "Rita Assistant",
    "copyright": "Skill3R01 — Rita clean-room rebuild",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "electron/ui/**",
      "electron/scripts/**",
      "helper/requirements.txt",
      "!**/*.spec",
      "!**/_pack_entry.py",
      "package.json",
      "README.md",
      "ROADMAP.md"
    ],
    "asar": true,
    "extraResources": [
      { "from": "electron/resources/helper", "to": "helper" },
      { "from": "electron/resources/kokoro", "to": "kokoro" },
      { "from": "electron/resources/wakeword", "to": "wakeword" }
    ],
    "win": { "target": "nsis", "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  },
  "author": "Rita project",
  "license": "MIT",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  }
}
